# Tuntu v0.1 startup and secret overrides.
# Profiles, sources, rules, schedules, and destinations are configured in the
# Web UI and stored in SQLite. This file is not the runtime source of truth.

TUNTU_DATA_DIR=/data
TUNTU_TIMEZONE=Asia/Shanghai
TUNTU_HOST=0.0.0.0
TUNTU_PORT=8000
TUNTU_LOG_LEVEL=INFO
TUNTU_MAX_CONCURRENT_RUNS=2
TUNTU_ALLOWED_HOSTS=*
TUNTU_COOKIE_SECURE=false
TUNTU_SETUP_TOKEN_TTL_MINUTES=30
TUNTU_SESSION_DAYS=7

# Optional CloudDrive2 bootstrap/secret overrides. Leave blank to configure in
# the setup UI. Examples: http://clouddrive2:19798, https://nas.example:19798
# Local-network services bypass the global outbound proxy by default.
TUNTU_CD2_ENDPOINT=
TUNTU_CD2_AUTH_MODE=api_token
TUNTU_CD2_API_TOKEN=
TUNTU_CD2_USERNAME=
TUNTU_CD2_PASSWORD=
# API-visible path. For a token restricted to the intended host folder, use /.
TUNTU_CD2_ROOT=
TUNTU_CD2_TEST_SUBDIR=.tuntu-test
TUNTU_CD2_TLS_VERIFY=true
TUNTU_CD2_CA_CERTIFICATE=
TUNTU_CD2_RPC_TIMEOUT_SECONDS=8
TUNTU_CD2_TASK_LIST_TIMEOUT_SECONDS=8
TUNTU_CD2_POLL_INTERVAL_SECONDS=300
TUNTU_CD2_ATTENTION_AFTER_HOURS=24
TUNTU_CD2_CHECK_FOLDER_AFTER_SECONDS=5
TUNTU_CD2_REQUIRED_STABLE_OBSERVATIONS=2
TUNTU_CD2_MAX_TREE_DEPTH=8
TUNTU_CD2_MAX_TREE_ENTRIES=10000

# Optional public Provider outbound proxy. Examples:
# TUNTU_OUTBOUND_PROXY=http://proxy:7890
# TUNTU_OUTBOUND_PROXY=socks5://proxy:1080
TUNTU_OUTBOUND_PROXY=
TUNTU_PROVIDER_TIMEOUT_SECONDS=15
TUNTU_PROVIDER_RETRIES=2
TUNTU_PROVIDER_BACKOFF_SECONDS=0.25
TUNTU_PROVIDER_CACHE_TTL_SECONDS=300
TUNTU_PROVIDER_MIN_INTERVAL_SECONDS=1
TUNTU_PROVIDER_MAX_RESPONSE_BYTES=3000000

# Optional ranking privacy and provider endpoint overrides. These are also
# configurable in the Web UI. Modes: none, blur, normal.
TUNTU_COVER_DISPLAY_MODE=blur
TUNTU_JAVDB_BASE_URL=https://javdb.com
# Prefer configuring this secret in the Web UI; leave blank for public pages.
TUNTU_JAVDB_COOKIE=
# Keep this aligned with the browser that produced the configured Cookie.
TUNTU_JAVDB_USER_AGENT=
TUNTU_JAVDATABASE_FEED_URL=https://www.javdatabase.com/category/top-jav-movies/feed/
TUNTU_SUKEBEI_FEED_URL=https://sukebei.nyaa.si/
TUNTU_KNABEN_API_URL=https://api.knaben.org/v1
TUNTU_BITSEARCH_API_URL=https://bitsearch.to/api/v1/search

# Optional operator-controlled or licensed candidate API.
TUNTU_AUTHORIZED_CANDIDATE_API_URL=
TUNTU_AUTHORIZED_CANDIDATE_API_TOKEN=
